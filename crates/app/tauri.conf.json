{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GoXLR Hub",
  "identifier": "io.github.silvundev.goxlr-hub",
  "build": {
    "frontendDist": "../../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GoXLR Hub",
        "width": 1120,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "backgroundColor": "#20241F",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "rpm",
      "appimage"
    ],
    "license": "GPL-3.0-or-later",
    "publisher": "GoXLR Hub contributors",
    "homepage": "https://github.com/SilvunDev/goxlr-hub",
    "category": "Utility",
    "shortDescription": "Control app for the TC-Helicon GoXLR (unofficial)",
    "longDescription": "Open source control app for the full-size TC-Helicon GoXLR. Unofficial, not affiliated with TC-Helicon.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer/hooks.nsh",
        "languages": [
          "English",
          "French"
        ],
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libusb-1.0-0"
        ],
        "files": {
          "/usr/lib/udev/rules.d/70-goxlr-hub.rules": "installer/70-goxlr-hub.rules"
        }
      },
      "rpm": {
        "depends": [
          "libusb-1.0.so.0()(64bit)"
        ],
        "files": {
          "/usr/lib/udev/rules.d/70-goxlr-hub.rules": "installer/70-goxlr-hub.rules"
        }
      }
    }
  }
}
